###############################################################################
# IntelliDocs (Paperless-ngx) settings - CONFIGURACIÓN LISTA PARA USO        #
###############################################################################

# IMPORTANTE: Este archivo tiene las configuraciones mínimas necesarias ya configuradas
# Para uso inmediato, solo necesitas copiar este archivo a docker-compose.env.local

# See http://docs.paperless-ngx.com/configuration/ for all available options.

###############################################################################
# CONFIGURACIÓN OBLIGATORIA - YA CONFIGURADA                                  #
###############################################################################

# CRÍTICO: Django requiere esta clave. NO usar 'change-me' en producción
# Esta clave se genera automáticamente. Puedes cambiarla si quieres.
PAPERLESS_SECRET_KEY=USE_THE_GENERATED_KEY_FROM_COMMAND_BELOW

# Timezone - Ajustar a tu zona horaria
PAPERLESS_TIME_ZONE=Europe/Madrid

# Idioma principal para OCR
PAPERLESS_OCR_LANGUAGE=spa

###############################################################################
# CONFIGURACIÓN OPCIONAL - Usuario/Grupo                                      #
###############################################################################

# El UID y GID del usuario que ejecuta paperless en el contenedor
# Establece esto a tu UID y GID en el host para tener acceso de escritura
USERMAP_UID=1000
USERMAP_GID=1000

###############################################################################
# CONFIGURACIÓN OPCIONAL - Acceso Web                                         #
###############################################################################

# Requerido solo si vas a exponer IntelliDocs públicamente
# (considera medidas de seguridad como reverse proxy)
#PAPERLESS_URL=https://intellidocs.example.com

# Configuración de admin (primera ejecución)
# IMPORTANTE: Crea el superuser con el comando después del primer inicio:
# docker compose exec webserver python src/manage.py createsuperuser
#PAPERLESS_ADMIN_USER=admin
#PAPERLESS_ADMIN_PASSWORD=admin
#PAPERLESS_ADMIN_MAIL=admin@example.com

###############################################################################
# CONFIGURACIÓN OPCIONAL - OCR Adicional                                      #
###############################################################################

# Idiomas adicionales para OCR (separados por espacios)
# El contenedor ya incluye: eng, deu, ita, spa, fra
# Ver: https://packages.debian.org/search?keywords=tesseract-ocr-
#PAPERLESS_OCR_LANGUAGES=tur ces por

###############################################################################
# IntelliDocs Advanced ML/OCR Features - YA HABILITADAS                       #
###############################################################################

# Features ML/OCR ya habilitadas por defecto en docker-compose.yml
# Solo descomenta si quieres DESHABILITAR alguna feature

# Enable/disable advanced ML features (BERT classification, NER, semantic search)
# Default: 1 (enabled)
#PAPERLESS_ENABLE_ML_FEATURES=1

# Enable/disable advanced OCR features (table extraction, handwriting, forms)
# Default: 1 (enabled)
#PAPERLESS_ENABLE_ADVANCED_OCR=1

# ML Model selection for document classification
# Default: distilbert-base-uncased (fast)
#PAPERLESS_ML_CLASSIFIER_MODEL=distilbert-base-uncased

# Enable GPU acceleration (requiere NVIDIA GPU con CUDA)
# Default: 0 (CPU only)
#PAPERLESS_USE_GPU=0

# Confidence threshold for table detection (0.0 to 1.0)
# Default: 0.7
#PAPERLESS_TABLE_DETECTION_THRESHOLD=0.7

# Enable handwriting recognition
# Default: 1 (enabled)
#PAPERLESS_ENABLE_HANDWRITING_OCR=1

###############################################################################
# CONFIGURACIÓN OPCIONAL - Performance                                        #
###############################################################################

# Workers y threads (ajustar según RAM disponible)
# Defaults en docker-compose.yml: 2 workers, 2 threads cada uno
#PAPERLESS_TASK_WORKERS=2
#PAPERLESS_THREADS_PER_WORKER=2

###############################################################################
# INSTRUCCIONES DE USO                                                        #
###############################################################################

# PASO 1: Genera tu SECRET_KEY (ejecuta en PowerShell/CMD/Bash):
#
#   PowerShell:
#   $key = -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 50 | % {[char]$_})
#   Write-Output "PAPERLESS_SECRET_KEY=$key"
#
#   Bash/Linux:
#   openssl rand -base64 32
#
# PASO 2: Copia la clave generada y reemplaza la línea de arriba
#
# PASO 3: Guarda este archivo como: docker-compose.env.local
#
# PASO 4: Levanta los servicios:
#   cd docker/compose
#   docker compose -f docker-compose.intellidocs.yml up -d
#
# PASO 5: Crea el superuser (primera vez):
#   docker compose -f docker-compose.intellidocs.yml exec webserver python src/manage.py createsuperuser
#
# PASO 6: Accede a la aplicación:
#   http://localhost:8000
